# Base de datos (Neon Postgres — ver integración Vercel Marketplace)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Número de WhatsApp de contacto, formato internacional sin "+" ni espacios
# Ejemplo: 5491122334455 (54 = Argentina, 9 + código de área sin el 0, número sin el 15)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491122334455"

# URL pública del sitio (usada en metadatos SEO / Open Graph)
NEXT_PUBLIC_SITE_URL="https://miunidad360.com"

# Back-office /admin (selector de unidades)
# Contraseña de acceso. Usá un valor largo y único en producción.
ADMIN_PASSWORD="cambiar-esta-contraseña"
# Secreto para firmar la cookie de sesión del admin (HMAC-SHA256).
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="generar-un-secreto-aleatorio-de-32-bytes"

# Cuentas de clientes en /admin (Better Auth, login con link mágico por email)
# Secreto para firmar las sesiones. Generalo igual que ADMIN_SESSION_SECRET (otro valor).
BETTER_AUTH_SECRET="generar-otro-secreto-aleatorio-de-32-bytes"
# URL base del sitio, sin barra final: los links mágicos apuntan acá.
BETTER_AUTH_URL="http://localhost:3000"
# Resend (resend.com → API Keys). Sin clave, en desarrollo el link se imprime en la consola
# del servidor; en producción es obligatoria.
RESEND_API_KEY=""
# Remitente de los emails, en un dominio verificado en Resend.
EMAIL_FROM="MiUnidad360 <acceso@miunidad360.com>"

# Google Maps Platform: Map Tiles API (Photorealistic 3D Tiles) para el selector en su
# ubicación real. Es pública (la usa el navegador): restringila por referrer HTTP
# (miunidad360.com, localhost) y solo a "Map Tiles API" en Google Cloud Console.
# Sin clave, el selector muestra la ciudad procedural de siempre.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
