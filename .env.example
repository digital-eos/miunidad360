# Base de datos (Neon Postgres — ver integración Vercel Marketplace)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Número de WhatsApp de contacto, formato internacional sin "+" ni espacios
# Ejemplo: 5491122334455 (54 = Argentina, 9 + código de área sin el 0, número sin el 15)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491122334455"

# URL pública del sitio (usada en metadatos SEO / Open Graph)
NEXT_PUBLIC_SITE_URL="https://miunidad360.com.ar"

# Back-office /admin (selector de unidades)
# Contraseña de acceso. Usá un valor largo y único en producción.
ADMIN_PASSWORD="cambiar-esta-contraseña"
# Secreto para firmar la cookie de sesión del admin (HMAC-SHA256).
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="generar-un-secreto-aleatorio-de-32-bytes"
